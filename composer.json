{
    "name": "baconfy/indicators",
    "description": "Technical analysis indicators over exact decimal math. Framework-free, deterministic, no I/O.",
    "keywords": ["indicators", "technical-analysis", "trading", "decimal", "bigdecimal"],
    "homepage": "https://github.com/baconfy/indicators",
    "license": "MIT",
    "authors": [
        {
            "name": "Renato Dehnhardt",
            "email": "renatotkd@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "brick/math": "^0.18"
    },
    "require-dev": {
        "pestphp/pest": "^5.0",
        "illuminate/container": "^12.0",
        "illuminate/support": "^12.0"
    },
    "suggest": {
        "illuminate/support": "To use the Laravel bridge (IndicatorsServiceProvider)"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "Baconfy\\Indicators\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Baconfy\\Indicators\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Baconfy\\Indicators\\Bridge\\Laravel\\IndicatorsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest --parallel --compact"
    }
}
